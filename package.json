    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xiaoqiong0v0/opencode-ssh-tool.git"
  },
  "homepage": "https://github.com/xiaoqiong0v0/opencode-ssh-tool#readme",
  "bugs": {
