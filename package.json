  },
  "keywords": [
    "opencode",
    "plugin",
    "ssh",
    "sftp",
    "terminal"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@xiaoqiong0v0/opencode-plugin-logger": "^1.0.6",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "ssh2": "^1.16.0",
    "ws": "^8.21.3"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "^1.18.4"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/ssh2": "^1.15.4",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
